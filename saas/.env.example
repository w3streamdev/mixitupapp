NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0
PORT=8080
CORS_ORIGIN=*
APP_REGION=us-central1

# Database
DATABASE_URL=postgresql://user:pass@host:5432/mixitup

# Redis
REDIS_URL=redis://host:6379

# GCP
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_TASKS_SERVICE_URL=

# OIDC / JWT Auth
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Trovo
TROVO_CLIENT_ID=
TROVO_CLIENT_SECRET=
TROVO_REDIRECT_URI=
